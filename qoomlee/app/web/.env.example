# Local development — copy to app/web/.env.local
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time.
# The API services must list http://localhost:3000 in ALLOWED_ORIGINS (see repo-root .env.example).
NEXT_PUBLIC_QOOMLEE_API_URL=http://localhost:9988
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:9984
NEXT_PUBLIC_ENABLE_TEST_SCENARIOS=true
NEXT_PUBLIC_ENABLE_ALT_PAYMENT_METHODS=false
